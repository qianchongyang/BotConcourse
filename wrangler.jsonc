{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botconcourse-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/mcp", "/health"]},
  "durable_objects": {"bindings": [{"name": "WORKSPACE", "class_name": "Workspace"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Workspace"]}],
  "vars": {"ADMIN_USERNAME": "admin", "APP_ORIGIN": "https://your-botconcourse.example.com", "ENVIRONMENT": "production"},
  "observability": {"enabled": false}
}
